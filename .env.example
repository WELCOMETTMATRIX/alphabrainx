# Alpha Brain configuration
# Copy to .env.local and fill in your own values.
# Server-side only. Never expose provider secrets in client-side code.

# Stock / ETF / index quotes — https://finnhub.io (free tier works)
FINNHUB_API_KEY=your_finnhub_api_key_here



# AI features (AI Analyst, scanner, on-chain analysis).
# Provided automatically when running on Lovable; set manually for self-hosting.
LOVABLE_API_KEY=your_lovable_ai_gateway_key_here

=
